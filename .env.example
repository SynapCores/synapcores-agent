# ── SynapCores connection ────────────────────────────────────────────────
# Where your SynapCores gateway is reachable.
SYNAPCORES_URL=http://127.0.0.1:8080

# Auth: either username + password (the agent logs in and manages the JWT),
# or a pre-minted token. The first-boot admin password is printed ONCE in the
# container logs:  docker logs <name> | grep -A 12 FIRST-BOOT
SYNAPCORES_USERNAME=admin
SYNAPCORES_PASSWORD=change-me
# SYNAPCORES_TOKEN=eyJ...      # alternative to username/password

# ── Agent settings ───────────────────────────────────────────────────────
# Table namespace so the agent can coexist with other data.
SYNAPCORES_NAMESPACE=support_agent
# Identity used to scope conversation memory (so different users get different
# memories). One agent process can serve many users via --user.
AGENT_USER_ID=demo-user

# Request timeout in seconds. The bundled GGUF LLM is slow on a COLD start:
# the first GENERATE call on CPU can take ~30s while the model loads. Keep this
# generous, and raise the gateway's own request_timeout too (see README).
SYNAPCORES_TIMEOUT=300

# ── Bring-your-own LLM (optional) ─────────────────────────────────────────
# By default the agent uses the bundled GENERATE (zero external key). To use an
# external provider instead, wire it in the gateway's config (see README) and,
# optionally, surface the key here for your own reference.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
